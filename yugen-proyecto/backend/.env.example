# Copia este archivo como .env y llena los valores.
# Si la contraseña de Atlas tiene caracteres especiales (@, #, etc.), codifícalos en URL.
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/nekoya
PORT=4000
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta
ADMIN_EMAIL=tu@correo.com
# Genera el hash con: node -e "require('bcryptjs').hash('tu-clave',10).then(console.log)"
ADMIN_PASSWORD_HASH=pega-aqui-el-hash
